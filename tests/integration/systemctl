#!/usr/bin/env python3
"""Disposable test supervisor, NOT systemd. Runs real generated commands.
Report this shim explicitly; it does not verify systemd ordering or reboot.
"""
import json
import os
import pathlib
import shlex
import signal
import subprocess
import sys
import time

root = pathlib.Path(os.environ['GRE_PANEL_DIR'])
units = pathlib.Path(os.environ['HASHEM_UNIT_DIR'])
root.mkdir(parents=True, exist_ok=True)

def settings(unit):
    path = units / (unit if unit.endswith('.service') else unit + '.service')
    if not path.exists(): return {}
    cfg = {}
    for line in path.read_text().splitlines():
        if '=' in line:
            key, value = line.split('=', 1); cfg.setdefault(key, []).append(value)
    return cfg

def state_path(unit): return root / ('test-supervisor-' + unit.replace('.service', '') + '.json')

def alive(unit):
    p = state_path(unit)
    if not p.exists(): return False
    state = json.loads(p.read_text())
    if state.get('oneshot'): return True
    proc = pathlib.Path('/proc') / str(state['pid']) / 'stat'
    return proc.exists() and proc.read_text().split()[21] == state['birth']

def stop(unit):
    cfg, p = settings(unit), state_path(unit)
    if p.exists():
        state = json.loads(p.read_text())
        if not state.get('oneshot') and alive(unit):
            os.kill(state['pid'], signal.SIGTERM)
            for _ in range(30):
                if not alive(unit): break
                time.sleep(.05)
        p.unlink(missing_ok=True)
    for line in cfg.get('ExecStop', []): subprocess.run(shlex.split(line), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def start(unit):
    if alive(unit): return
    cfg = settings(unit)
    if not cfg: raise RuntimeError('missing owned test unit')
    for dependency in cfg.get('Requires', []):
        for dep in dependency.split(): start(dep)
    if cfg.get('Type') == ['oneshot']:
        for line in cfg['ExecStart']: subprocess.run(shlex.split(line), check=True)
        for line in cfg.get('ExecStartPost', []): subprocess.run(shlex.split(line), check=True)
        state_path(unit).write_text(json.dumps({'oneshot': True}))
    else:
        with open(root / (unit + '.test.log'), 'ab') as log: child = subprocess.Popen(shlex.split(cfg['ExecStart'][0]), stdout=log, stderr=log, start_new_session=True)
        birth = pathlib.Path('/proc', str(child.pid), 'stat').read_text().split()[21]
        state_path(unit).write_text(json.dumps({'pid': child.pid, 'birth': birth}))
        time.sleep(.3)
        if child.poll() is not None: raise RuntimeError('actual FRP process failed')

args = [x for x in sys.argv[1:] if not x.startswith('--')]
verb, targets = args[0], args[1:]
try:
    if verb == 'is-active': sys.exit(0 if all(alive(t) for t in targets) else 3)
    if verb in ('daemon-reload', 'enable', 'disable', 'reset-failed'): sys.exit(0)
    for target in targets:
        if verb in ('stop', 'restart'): stop(target)
        if verb in ('start', 'restart', 'reload-or-restart'): start(target)
except Exception as exc:
    print(str(exc), file=sys.stderr); sys.exit(1)
